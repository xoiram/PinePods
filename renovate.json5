// Renovate, self-hosted in the d42-infra cluster (docs/runbooks/renovate.md
// there). Fork-only, like ghcr-fork-publish.yml: leave it out of upstream PRs.
// Everything runs once a week, early Monday; security fixes (OSV) come
// right away. Minor and patch updates are grouped into two PRs (built parts,
// unbuilt): the one PR CI builds and tests (web, rust-api, gpodder-api, GitHub
// Actions) automerges once it passes; the parts no PR workflow builds are one
// PR to review. Minors of 0.x versions (breaking by semver) are one more
// reviewed PR; majors are separate PRs.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':dependencyDashboard'],
  timezone: 'Europe/Oslo',
  // Weekly, not daily: one batch of PRs to look at. Security PRs ignore this
  // (vulnerabilityAlerts has its own, empty schedule).
  schedule: ['before 6am on monday'],
  // Conventional commits ("chore(deps): update ...").
  semanticCommits: 'enabled',
  gitAuthor: 'Renovate <renovate@dot42.no>',
  // Renovate merges the PR itself after CI is green, not GitHub's auto-merge
  // (there's no branch protection to make that wait for CI).
  automergeType: 'pr',
  platformAutomerge: false,
  // config:recommended allows 2 new PRs an hour; with one window a week that
  // would leave groups waiting a week behind the rest.
  prHourlyLimit: 0,
  // The helm chart vendors its subcharts in charts/; keep them in step with Chart.lock.
  postUpdateOptions: ['helmUpdateSubChartArchives'],
  // Dependabot alerts are off on the fork; OSV gives security PRs without them.
  osvVulnerabilityAlerts: true,
  // Weekly lockfile refresh: the way transitive crates (openssl,
  // rustls-webpki, quinn-proto, ...) get their fixes.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ['before 6am on monday'],
  },
  packageRules: [
    {
      description: "The Flutter app in mobile/: not maintained on the fork (the upstream app works against this server), its workflows are disabled",
      matchFileNames: [
        'mobile/**',
        '.github/workflows/mobile-tests.yml',
        '.github/workflows/build-android-flutter.yml',
        '.github/workflows/build-ios-flutter.yml',
      ],
      enabled: false,
    },
    {
      description: 'Minor and patch updates: grouped per part of the repo below, automerged once CI passes',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    // Two groups, so one PR's CI run covers every built part at once. A failing
    // part holds the whole group back, which is the price of one run a week.
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['web/**', 'rust-api/**', 'gpodder-api/**', '.github/workflows/**'],
      groupName: 'built parts minor and patch',
      groupSlug: 'built-minor-patch',
    },
    // Not built by any PR workflow (desktop app, AI, search backend, helm and
    // compose): one PR, reviewed.
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['web/src-tauri/**', 'pinepods-ai/**', 'Backend/**', 'deployment/**'],
      groupName: 'unbuilt parts minor and patch',
      groupSlug: 'unbuilt-minor-patch',
      automerge: false,
    },
    {
      description: 'pinepods-ai: faster-whisper passes av.open(metadata_errors=), which PyAV 19 removed',
      matchFileNames: ['pinepods-ai/**'],
      matchPackageNames: ['av'],
      allowedVersions: '<19',
    },
    {
      description: 'pinepods-ai: no ctranslate2, onnxruntime or av wheels for Python 3.15 yet; raise this when there are',
      matchFileNames: ['pinepods-ai/Dockerfile'],
      matchDepNames: ['python'],
      allowedVersions: '<3.15',
    },
    {
      description: "pinepods-ai's Python: its own PR, as a new Python waits on wheels for faster-whisper's dependencies",
      matchFileNames: ['pinepods-ai/Dockerfile'],
      matchDepNames: ['python'],
      groupName: null,
      automerge: false,
    },
    {
      description: '0.x: a minor is a breaking release, so reviewed; all of them in one PR across the repo',
      matchCurrentVersion: '/^[~^=v]?0\\./',
      matchUpdateTypes: ['minor'],
      groupName: '0.x minor (breaking)',
      groupSlug: '0x-minor',
      automerge: false,
    },
  ],
}
