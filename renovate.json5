// Renovate, self-hosted in the d42-infra cluster (docs/runbooks/renovate.md
// there). Fork-only, like ghcr-fork-publish.yml: leave it out of upstream PRs.
// Minor and patch updates are grouped into two PRs a day (built parts, unbuilt),
// and those PR CI builds and tests (web, rust-api, gpodder-api, GitHub
// Actions) automerge once it passes. Parts no PR workflow builds are the same
// PRs, left to review. Majors, and minors of
// 0.x versions (breaking by semver), are separate PRs.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':dependencyDashboard'],
  timezone: 'Europe/Oslo',
  gitAuthor: 'Renovate <renovate@dot42.no>',
  // Renovate merges the PR itself after CI is green, not GitHub's auto-merge
  // (there's no branch protection to make that wait for CI).
  automergeType: 'pr',
  platformAutomerge: false,
  // config:recommended allows 2 new PRs an hour; with one daily window that
  // left the web and rust-api groups waiting a day behind the rest.
  prHourlyLimit: 0,
  // The helm chart vendors its subcharts in charts/; keep them in step with Chart.lock.
  postUpdateOptions: ['helmUpdateSubChartArchives'],
  // Dependabot alerts are off on the fork; OSV gives security PRs without them.
  osvVulnerabilityAlerts: true,
  // Weekly lockfile refresh: the way transitive crates (openssl,
  // rustls-webpki, quinn-proto, ...) get their fixes.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ['before 6am on monday'],
  },
  packageRules: [
    {
      description: "The Flutter app in mobile/: not maintained on the fork (the upstream app works against this server), its workflows are disabled",
      matchFileNames: [
        'mobile/**',
        '.github/workflows/mobile-tests.yml',
        '.github/workflows/build-android-flutter.yml',
        '.github/workflows/build-ios-flutter.yml',
      ],
      enabled: false,
    },
    {
      description: 'Minor and patch updates: grouped per part of the repo below, once a day, automerged once CI passes',
      matchUpdateTypes: ['minor', 'patch'],
      schedule: ['before 6am'],
      automerge: true,
    },
    // Two groups, so one PR's CI run covers every built part at once. A failing
    // part holds the whole group back, which is the price of one run a day.
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['web/**', 'rust-api/**', 'gpodder-api/**', '.github/workflows/**'],
      groupName: 'built parts minor and patch',
      groupSlug: 'built-minor-patch',
    },
    // Not built by any PR workflow: grouped the same way, but reviewed.
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['web/src-tauri/**', 'pinepods-ai/**', 'Backend/**', 'deployment/**'],
      groupName: 'unbuilt parts minor and patch',
      groupSlug: 'unbuilt-minor-patch',
      automerge: false,
    },
    {
      description: 'pinepods-ai: faster-whisper passes av.open(metadata_errors=), which PyAV 19 removed',
      matchFileNames: ['pinepods-ai/**'],
      matchPackageNames: ['av'],
      allowedVersions: '<19',
    },
    {
      description: 'pinepods-ai: no ctranslate2, onnxruntime or av wheels for Python 3.15 yet; raise this when there are',
      matchFileNames: ['pinepods-ai/Dockerfile'],
      matchDepNames: ['python'],
      allowedVersions: '<3.15',
    },
    {
      description: "pinepods-ai's Python: its own PR, as a new Python waits on wheels for faster-whisper's dependencies",
      matchFileNames: ['pinepods-ai/Dockerfile'],
      matchDepNames: ['python'],
      groupName: null,
      automerge: false,
    },
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['Backend/**'],
      groupName: 'search backend minor and patch',
      groupSlug: 'backend-minor-patch',
      automerge: false,
    },
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['deployment/**'],
      groupName: 'deployment (helm, compose) minor and patch',
      groupSlug: 'deployment-minor-patch',
      automerge: false,
    },
    {
      description: '0.x: a minor is a breaking release, so its own PR, reviewed',
      matchCurrentVersion: '/^[~^=v]?0\\./',
      matchUpdateTypes: ['minor'],
      groupName: null,
      automerge: false,
    },
  ],
}
